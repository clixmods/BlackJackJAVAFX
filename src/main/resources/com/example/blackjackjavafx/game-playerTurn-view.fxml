<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Table de jeu : croupier en haut, message de la manche au centre, joueur et actions en bas.
     La vue de sélection de mise est ajoutée à la fin de vueGlobale par ControleurJeu. -->
<VBox fx:id="vueGlobale" alignment="CENTER" spacing="22" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.blackjackjavafx.Application.controller.ControleurJeu">

    <padding>
        <Insets top="24" bottom="32" left="24" right="24"/>
    </padding>

    <VBox alignment="CENTER" spacing="14">
        <HBox fx:id="cardBoxDealer" alignment="CENTER" spacing="14"/>
        <Label fx:id="handDealerText" styleClass="valeur-main" text="Main du croupier" visible="false"/>
    </VBox>

    <Label fx:id="messageRoundText" styleClass="message-manche" text="Sélectionnez votre mise"/>

    <Button fx:id="buttonRestartRound" styleClass="bouton-principal, bouton-large" onAction="#onRestartButtonClick" text="Recommencer" visible="false"/>

    <VBox alignment="CENTER" spacing="14">
        <Label fx:id="handPlayerText" styleClass="valeur-main" visible="false"/>
        <HBox fx:id="cardBoxPlayer" alignment="CENTER" spacing="14"/>
    </VBox>

    <HBox fx:id="buttonBoxPlayer" alignment="CENTER" spacing="16" visible="false">
        <Button fx:id="buttonStand" styleClass="bouton-secondaire, bouton-action" onAction="#onStandButtonClick" text="Rester"/>
        <Button fx:id="buttonHit" styleClass="bouton-principal, bouton-action" onAction="#onHitButtonClick" text="Piocher"/>
    </HBox>

</VBox>
